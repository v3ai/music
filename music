#!/usr/bin/env bash
# music — start the server (sets everything up on first run).
#   ./music            run in the foreground
#   ./music update     update dependencies (yt-dlp etc.)
#   ./music service    install as a background service that starts on login (Linux, systemd)
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

if [ "${1:-}" = "service" ]; then
  unit="$HOME/.config/systemd/user/music.service"
  mkdir -p "$(dirname "$unit")"
  cat > "$unit" <<UNIT
[Unit]
Description=music server
After=network-online.target

[Service]
ExecStart=$PWD/music
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now music.service
  echo "✓ music is running in the background and will start on login."
  echo "  logs: journalctl --user -u music -f    stop: systemctl --user disable --now music"
  exit 0
fi

PY=${PYTHON:-python3}
if [ ! -x .venv/bin/python ]; then
  echo "› first run: creating virtualenv…"
  "$PY" -m venv .venv
  .venv/bin/pip install -q --upgrade pip
  .venv/bin/pip install -q -r requirements.txt
  touch .venv/.updated
fi

if ! command -v ffmpeg >/dev/null; then
  echo "! ffmpeg not found — playback works, but downloads won't get tags/cover art."
  echo "  install it with your package manager (e.g. sudo apt install ffmpeg / brew install ffmpeg)"
fi

# YouTube changes often; keep yt-dlp fresh (at most once a day, never blocks startup on failure)
if [ "${1:-}" = "update" ] || [ -z "$(find .venv/.updated -mtime -1 2>/dev/null)" ]; then
  echo "› updating yt-dlp…"
  .venv/bin/pip install -q --upgrade -r requirements.txt "yt-dlp[default]" || echo "! update failed (offline?) — continuing"
  touch .venv/.updated
  [ "${1:-}" = "update" ] && exit 0
fi

exec .venv/bin/python -m server
